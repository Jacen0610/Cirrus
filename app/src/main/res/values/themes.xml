<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Cirrus" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Android 12+ 系统 SplashScreen：纯白背景 + 彩色品牌图标（Gmail 式反白），结束后回落到应用主题 -->
    <style name="Theme.Cirrus.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/white</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_logo_colored</item>
        <item name="postSplashScreenTheme">@style/Theme.Cirrus</item>
    </style>
</resources>