<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Cirrus" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- Android 12+ 系统 SplashScreen：启动展示云朵图标，结束后回落到应用主题 -->
    <style name="Theme.Cirrus.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/cirrus_sky</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/brand_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.Cirrus</item>
    </style>
</resources>